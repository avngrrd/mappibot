# Set these only on the computer/server running the bot. Never commit real values.
TELEGRAM_BOT_TOKEN=
# Random invitation code: share the resulting t.me/<bot>?start=<code> with friends.
INVITE_CODE=
# Optional fixed Telegram numeric user IDs, comma separated.
ALLOWED_USER_IDS=
DATA_DIR=./data
USER_AGENT=MappiBot/0.1 (https://github.com/avngrrd/mappibot)
# Optional providers, replace without changing application code.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OVERPASS_URL=https://overpass-api.de/api/interpreter
DNIPRO_URL=https://api-t900.icity.com.ua/api/gps_data/
KYIV_GTFS_RT_URL=http://193.23.225.214:732/api/realtime
# Local Mini App server. Windows launcher sets these automatically.
MAP_PORT=8787
MAP_PREVIEW_KEY=
MAP_URL=
MAP_URL_FILE=
STOP_FILE=
